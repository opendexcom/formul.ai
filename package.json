{
  "name": "formulai",
  "version": "0.4.0",
  "description": "AI-powered survey analytics platform for building forms, collecting responses, and generating actionable insights.",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm --filter server dev\" \"pnpm --filter client dev\"",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "dev:worker": "pnpm --filter server worker:dev",
    "start:worker": "pnpm --filter server run worker",
    "start:worker:dev": "pnpm --filter server run worker:dev",
    "start:worker:prod": "pnpm --filter server run worker:prod",
    "build": "pnpm run build:client && pnpm run build:server",
    "build:client": "pnpm --filter client build",
    "build:server": "pnpm --filter server build",
    "install:all": "pnpm install -w",
    "docker:up": "docker compose -f ../docker-compose.yml up -d --build",
    "docker:down": "docker compose -f ../docker-compose.yml down",
    "docker:logs": "docker compose -f ../docker-compose.yml logs -f",
    "db:start": "docker compose -f ../docker-compose.yml up -d mongodb redis",
    "db:stop": "docker compose -f ../docker-compose.yml stop mongodb redis",
    "db:admin": "docker compose -f ../docker-compose.yml --profile dev up -d mongo-express && echo MongoDB Admin: http://localhost:8081"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "forms",
    "nestjs",
    "react",
    "typescript",
    "mongodb"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.23.0"
}