# Server Environment Variables
MONGODB_URI=mongodb://localhost:27017/formulai
REDIS_HOST=localhost
PORT=3001
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=7d
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.7
FRONTEND_URL=http://localhost:3000
FROM_EMAIL="FormulAI <noreply@formulai.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=user
SMTP_PASS=pass
NODE_ENV=development
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# MLflow Prompt Registry
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_PROMPT_ALIAS=production
MLFLOW_PROMPT_CACHE_TTL_SECONDS=60
LLM_SEMANTIC_CACHE_ENABLED=true
LLM_SEMANTIC_CACHE_TTL_SECONDS=86400
LLM_SEMANTIC_CACHE_SIMILARITY=0.95
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
LOCAL_EMBEDDING_WARMUP=true
LOCAL_EMBEDDING_THREADS=2
LLM_EMBEDDING_DIMENSION=384
TRANSFORMERS_CACHE=.cache/transformers
# Optional fallbacks (not used when EMBEDDING_PROVIDER=local)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
