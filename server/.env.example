# Server Environment Variables
MONGODB_URI=mongodb://localhost:27017/formulai
# Local dev: use Redis Stack from repo-root `docker compose up -d redis` (RediSearch required)
REDIS_HOST=localhost
REDIS_PORT=6379
PORT=3001
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=7d
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.7
FRONTEND_URL=http://localhost:3000
FROM_EMAIL="FormulAI <noreply@formulai.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=user
SMTP_PASS=pass
SMTP_SECURE=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
NODE_ENV=development
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# MLflow Prompt Registry
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_PROMPT_ALIAS=production
MLFLOW_PROMPT_CACHE_TTL_SECONDS=60
# LangChain tracing (OpenTelemetry → MLflow Traces tab)
MLFLOW_TRACING_ENABLED=true
MLFLOW_EXPERIMENT_NAME=formulai
# MLFLOW_EXPERIMENT_ID=
LLM_SEMANTIC_CACHE_ENABLED=true
LLM_SEMANTIC_CACHE_TTL_SECONDS=86400
LLM_SEMANTIC_CACHE_SIMILARITY=0.95
EMBEDDING_PROVIDER=local
# 384-d multilingual E5 (same DIM as the previous English MiniLM default)
LOCAL_EMBEDDING_MODEL=Xenova/multilingual-e5-small
LOCAL_EMBEDDING_WARMUP=true
LOCAL_EMBEDDING_THREADS=2
LLM_EMBEDDING_DIMENSION=384
# Opt-in local model comparison (downloads Hugging Face models; skip in CI):
# RUN_LOCAL_EMBEDDING_CLUSTER_TEST=1
TRANSFORMERS_CACHE=.cache/transformers
# Analytics processing tuning
ANALYTICS_CHUNK_CONCURRENCY=4
ANALYTICS_BATCH_SIZE=50
ANALYTICS_CHUNK_SIZE_SHORT=20
ANALYTICS_CHUNK_SIZE_MED=10
ANALYTICS_CHUNK_SIZE_LONG=5
ANALYTICS_CLUSTER_BATCH_SIZE=200
ANALYTICS_BULK_WRITE_BATCH_SIZE=500
ANALYTICS_QUEUE_RATE_MAX=100
ANALYTICS_TREND_SAMPLE_SIZE=2000
ANALYTICS_CLOSED_QUESTION_SAMPLE_SIZE=5000
ANALYTICS_QUOTE_FETCH_LIMIT=100
# Vector-based topic clustering (Redis Stack + embeddings)
ANALYTICS_TOPIC_VECTOR_CLUSTERING=true
# Leave unset to use the per-model default (MiniLM 0.82, E5 0.90).
# Set only to override:
# ANALYTICS_TOPIC_SIMILARITY_THRESHOLD=0.90
ANALYTICS_TOPIC_KNN_K=15
ANALYTICS_TOPIC_LLM_LABEL_CLUSTERS=true
