{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "build:prod": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "worker": "nest start --entryFile worker",
    "worker:dev": "nest start --watch --entryFile worker",
    "worker:prod": "node dist/src/worker",
    "start:worker": "pnpm run worker",
    "start:worker:dev": "pnpm run worker:dev",
    "start:worker:prod": "pnpm run worker:prod",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "generate:responses": "ts-node scripts/generate-fake-responses.ts"
  },
  "dependencies": {
    "@arizeai/openinference-instrumentation-langchain": "^4.0.12",
    "@bull-board/api": "^6.14.0",
    "@bull-board/express": "^6.14.0",
    "@bull-board/nestjs": "^6.14.0",
    "@huggingface/transformers": "^4.2.0",
    "@langchain/community": "^1.1.28",
    "@langchain/core": "^1.1.47",
    "@langchain/langgraph": "^1.1.4",
    "@langchain/openai": "^1.4.6",
    "@mlflow/core": "^0.2.0",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^11.1.21",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.21",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.21",
    "@nestjs/swagger": "^11.4.3",
    "@opendataloader/pdf": "^2.2.1",
    "@opendexcom/plugin-interface": "workspace:*",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.219.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "bcryptjs": "^3.0.2",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dodopayments": "^2.6.0",
    "dotenv": "^17.2.3",
    "ioredis": "^5.8.2",
    "js-yaml": "^4.2.0",
    "langchain": "^1.2.23",
    "libreoffice-convert": "^1.8.1",
    "mongoose": "^8.24.0",
    "nodemailer": "^9.0.1",
    "openai": "^6.7.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdf2json": "^4.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.21",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "pdfkit": "^0.18.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.spec.ts",
      "!**/index.(t|j)s",
      "!main.ts",
      "!worker.ts",
      "!**/*.module.ts",
      "!**/*.controller.ts",
      "!**/dto/**",
      "!**/*.dto.ts",
      "!analytics/queues/**",
      "!analytics/core/analytics.orchestrator.ts",
      "!analytics/core/task.manager.ts",
      "!analytics/processors/**",
      "!analytics/stores/**",
      "!analytics/utils/**",
      "!migrations/**",
      "!plugins/**",
      "!monitoring/**",
      "!**/*.schema.ts",
      "!**/core-schema-registry.ts",
      "!auth/jwt-auth.guard.ts",
      "!auth/jwt.strategy.ts",
      "!auth/roles.guard.ts",
      "!auth/roles.decorator.ts",
      "!forms/analytics.service.ts",
      "!analytics/generators/summary.generator.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}